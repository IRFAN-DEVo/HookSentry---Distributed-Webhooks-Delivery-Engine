# ==============================================================================
# HookSentry Environment Variables
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-hooksentry-production-grade-super-secret-key-change-in-prod-!#992
ALLOWED_HOSTS=localhost,127.0.0.1,web,api

# Encryption Key (Fernet 32-byte url-safe base64 key for endpoint signing secrets)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZmVybmV0LWtleS0xMjM0NQ==

# Database (PostgreSQL)
DB_NAME=hooksentry
DB_USER=hooksentry_user
DB_PASSWORD=hooksentry_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Delivery Engine Parameters
MAX_DELIVERY_ATTEMPTS=5
INITIAL_RETRY_DELAY_SECONDS=2
BACKOFF_FACTOR=2
MAX_RETRY_DELAY_SECONDS=300
PROCESSING_LEASE_SECONDS=60
HTTP_REQUEST_TIMEOUT_SECONDS=10

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
